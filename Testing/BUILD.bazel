load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The checked-in wrapper includes the template without substitutions. Declare
# both source files so MSVC's include search cannot select an undeclared header
# instead of a generated file with the same name.
cc_library(
    name = "vectorizationTest_header",
    hdrs = [
        "VectorizationTest.h",
    ],
    textual_hdrs = ["VectorizationTest.h.in"],
    includes = ["."],
    deps = ["//:Vectorization"],
)
