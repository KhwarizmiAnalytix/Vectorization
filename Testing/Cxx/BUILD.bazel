load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("//bazel:hip.bzl", "hip_library")
load(
    "//bazel:vectorization.bzl",
    "vectorization_arch_copts",
    "vectorization_copts",
    "vectorization_defines",
    "vectorization_gpu_copts",
    "vectorization_linkopts",
)

package(default_visibility = ["//visibility:public"])

# Keep the device query in Objective-C++ while GPU tests stay plain C++.
copy_file(
    name = "metal_device_probe_objcxx",
    src = "metal_device_probe.mm",
    out = "metal_device_probe_mm.cc",
)

cc_library(
    name = "metal_device_probe",
    srcs = select({
        "//bazel:enable_metal": [":metal_device_probe_objcxx"],
        "//conditions:default": [],
    }),
    copts = select({
        "//bazel:enable_metal": [
            "-x",
            "objective-c++",
            "-fobjc-arc",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "//bazel:enable_metal": [
            "-framework",
            "Metal",
            "-framework",
            "Foundation",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)

# Compile every tensor expression TU with the same device compiler to avoid
# mixing CPU-only and GPU template definitions in one executable (ODR).
_GPU_TEST_SRCS = [
    "TestTensor.cpp",
    "TestTensorF1.cpp",
    "TestTensorF2.cpp",
    "TestTensorF3.cpp",
    "TestTensorGpu.cpp",
    "TestTensorGpuProfiler.cpp",
    "TestTensorReductions.cpp",
    "TestTensorShapes.cpp",
    "TestTensorView.cpp",
]

_GPU_TEST_DEFINES = vectorization_defines() + [
    "VECTORIZATION_GOOGLE_TEST",
    "USE_GTEST",
    "_VARIADIC_MAX=10",
    "VECTORIZATION_HAS_GTEST=1",
]

_GPU_TEST_DEPS = [
    "//:Vectorization",
    "//Testing:vectorizationTest_header",
    "@com_google_googletest//:gtest",
]

cuda_library(
    name = "tensor_cuda_tests",
    testonly = True,
    srcs = _GPU_TEST_SRCS,
    hdrs = glob(["*.h"]),
    copts = ["-std=c++20"] + select({
        "@rules_cuda//cuda:compiler_is_nvcc": ["--expt-relaxed-constexpr"],
        "//conditions:default": [],
    }),
    defines = _GPU_TEST_DEFINES,
    host_copts = vectorization_arch_copts() + vectorization_gpu_copts(),
    includes = ["."],
    target_compatible_with = select({
        "//bazel:enable_cuda": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = _GPU_TEST_DEPS,
    alwayslink = True,
)

hip_library(
    name = "tensor_hip_tests",
    testonly = True,
    srcs = _GPU_TEST_SRCS,
    hdrs = glob(["*.h"]),
    copts = vectorization_copts() + vectorization_arch_copts() + vectorization_gpu_copts(),
    defines = _GPU_TEST_DEFINES,
    enabled = "//bazel:enable_hip",
    includes = ["."],
    deps = _GPU_TEST_DEPS,
    alwayslink = True,
)

# Excluded from the Bazel test glob (all CMake-only dependencies -- see
# Scripts/setup_bazel.py's --help -- unwired in this repo's Bazel build):
#   - TestTensorLibTorch*.cpp: VECTORIZATION_ENABLE_LIBTORCH (LibTorch SDK)
# Tensor sources move to the device library for CUDA/HIP builds; CPU and
# Metal builds keep them in this ordinary C++ test target.
# TestMetalDispatch.mm is excluded implicitly -- the glob pattern below only
# matches "Test*.cpp".
cc_test(
    name = "VectorizationCxxTests",
    size = "large",
    timeout = "long",
    srcs = glob(
        ["Test*.cpp"],
        allow_empty = True,
        exclude = ["TestTensorLibTorch*.cpp"] + _GPU_TEST_SRCS,
    ) + select({
        "//bazel:enable_cuda": [],
        "//bazel:enable_hip": [],
        "//conditions:default": _GPU_TEST_SRCS,
    }),
    copts = vectorization_copts() + vectorization_arch_copts() + vectorization_gpu_copts(),
    defines = vectorization_defines() + [
        "VECTORIZATION_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
        "VECTORIZATION_HAS_GTEST=1",
        "VECTORIZATION_HAS_LIBTORCH=0",
    ],
    includes = ["."],
    linkopts = vectorization_linkopts(),
    deps = [
        "//:Vectorization",
        "//Testing:vectorizationTest_header",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ] + select({
        "//bazel:enable_cuda": [":tensor_cuda_tests"],
        "//bazel:enable_hip": [":tensor_hip_tests"],
        "//conditions:default": [],
    }) + select({
        "//bazel:enable_metal": [":metal_device_probe"],
        "//conditions:default": [],
    }),
)

cuda_library(
    name = "tensor_cuda_benchmark",
    srcs = ["BenchmarkTensorGpu.cpp"],
    hdrs = glob(["*.h"]),
    copts = ["-std=c++20"] + select({
        "@rules_cuda//cuda:compiler_is_nvcc": ["--expt-relaxed-constexpr"],
        "//conditions:default": [],
    }),
    defines = vectorization_defines(),
    host_copts = vectorization_arch_copts() + vectorization_gpu_copts(),
    includes = ["."],
    target_compatible_with = select({
        "//bazel:enable_cuda": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//:Vectorization",
        "//Testing:vectorizationTest_header",
        "@com_google_benchmark//:benchmark",
    ],
    alwayslink = True,
)

hip_library(
    name = "tensor_hip_benchmark",
    srcs = ["BenchmarkTensorGpu.cpp"],
    hdrs = glob(["*.h"]),
    copts = vectorization_copts() + vectorization_arch_copts() + vectorization_gpu_copts(),
    defines = vectorization_defines(),
    enabled = "//bazel:enable_hip",
    includes = ["."],
    deps = [
        "//:Vectorization",
        "//Testing:vectorizationTest_header",
        "@com_google_benchmark//:benchmark",
    ],
    alwayslink = True,
)

# One cc_binary per Benchmark*.cpp -- mirrors Testing/Cxx/CMakeLists.txt.
# Excluded (CMake-only dependencies, same rationale as the test glob above):
#   - BenchmarkTensorLibTorch.cpp: VECTORIZATION_ENABLE_LIBTORCH
#   - BenchmarkTensorMkl.cpp: VECTORIZATION_ENABLE_MKL
[
    cc_binary(
        name = "benchmark_" + _src[len("Benchmark"):-len(".cpp")].lower(),
        srcs = (["BenchmarkSimdUnaryShared.h"] + select({
            "//bazel:enable_cuda": [],
            "//bazel:enable_hip": [],
            "//conditions:default": [_src],
        })) if _src == "BenchmarkTensorGpu.cpp" else [
            _src,
            "BenchmarkSimdUnaryShared.h",
        ],
        copts = vectorization_copts() + vectorization_arch_copts() + vectorization_gpu_copts(),
        defines = vectorization_defines() + [
            "VECTORIZATION_HAS_LIBTORCH=0",
        ],
        includes = ["."],
        linkopts = vectorization_linkopts(),
        deps = [
            "//:Vectorization",
            "//Testing:vectorizationTest_header",
            "@com_google_benchmark//:benchmark",
            "@com_google_benchmark//:benchmark_main",
        ] + (select({
            "//bazel:enable_cuda": [":tensor_cuda_benchmark"],
            "//bazel:enable_hip": [":tensor_hip_benchmark"],
            "//conditions:default": [],
        }) if _src == "BenchmarkTensorGpu.cpp" else []) + select({
            "//bazel:enable_metal": [":metal_device_probe"],
            "//conditions:default": [],
        }),
    )
    for _src in glob(
        ["Benchmark*.cpp"],
        allow_empty = True,
        exclude = [
            "BenchmarkTensorLibTorch.cpp",
            "BenchmarkTensorMkl.cpp",
        ],
    )
]
