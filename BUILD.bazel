# Standalone Vectorization library (KhwarizmiAnalytix/Vectorization). Public headers
# live under include/, which is also the include root (e.g. "terminals/tensor.h",
# "backend/simd.h"). CPU SIMD backend and GPU backend are independent --define=
# flags -- see bazel/BUILD.bazel and docs/vectorization_backends.md.
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load(
    "//bazel:vectorization.bzl",
    "vectorization_arch_copts",
    "vectorization_copts",
    "vectorization_defines",
    "vectorization_linkopts",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "vectorization_hdrs",
    srcs = glob(
        [
            "include/common/*.h",
            "include/expressions/*.h",
            "include/terminals/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "vectorization_srcs",
    srcs = glob(
        [
            "src/common/*.cpp",
            "src/terminals/*.cpp",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "vectorization_lib",
    srcs = [
        ":vectorization_srcs",
    ],
    hdrs = [
        ":vectorization_hdrs",
    ],
    copts = vectorization_copts() + vectorization_arch_copts(),
    defines = vectorization_defines() + select({
        "//bazel:shared_libs": ["VECTORIZATION_SHARED_DEFINE", "VECTORIZATION_BUILDING_DLL"],
        "//conditions:default": ["VECTORIZATION_STATIC_DEFINE"],
    }),
    includes = ["include"],
    linkopts = vectorization_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    deps = [
        "@logging//:Logging",
        "@memory//:Memory",
        "@scalars//:Scalars",
    ] + select({
        "//bazel:disable_profiler": [],
        "//conditions:default": ["@profiler//:Profiler"],
    }) + select({
        # Mirrors Memory's own bazel/BUILD.bazel (@local_config_cuda -- not yet
        # defined by this workspace or Memory's; see Scripts/setup_bazel.py's
        # module docstring). CUDA kernels also need TestTensorGpu.cpp-style
        # LANGUAGE CUDA tagging, which this cc_library does not attempt.
        "//bazel:enable_cuda": ["@local_config_cuda//:cuda"],
        "//conditions:default": [],
    }) + select({
        "//bazel:enable_hip": ["@local_config_hip//:hip"],
        "//conditions:default": [],
    }),
    alwayslink = False,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "Vectorization",
    deps = [":vectorization_lib"],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS ...)` /
# `install(DIRECTORY ... DESTINATION include/Vectorization ...)` in
# CMakeLists.txt). `bazel build //:vectorization_pkg_tar` produces a
# relocatable tarball; `bazel run //:install -- --destdir=/some/prefix`
# stages the same tree directly on disk.
# =============================================================================

pkg_files(
    name = "vectorization_installed_hdrs",
    srcs = [":vectorization_hdrs"],
    prefix = "include/Vectorization",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "vectorization_installed_libs",
    srcs = [":vectorization_lib"],
    prefix = "lib",
)

pkg_tar(
    name = "vectorization_pkg_tar",
    srcs = [
        ":vectorization_installed_hdrs",
        ":vectorization_installed_libs",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":vectorization_installed_hdrs",
        ":vectorization_installed_libs",
    ],
)
