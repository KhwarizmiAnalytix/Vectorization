# Pure Bzlmod (no WORKSPACE.bazel) — matches the sibling Logging and
# LinearAlgebra repos. Every ThirdParty/ submodule is wired via MODULE.bazel
# (use_repo_rule), so Bazel 9's removal of WORKSPACE-based repos
# (local_repository / new_local_repository in a WORKSPACE file) doesn't
# affect this repo. See .bazelversion.

# Auto-select the build:<os>/test:<os> blocks below for the host platform
# (linux/macos/windows), so cross-platform flags don't need --config.
common --enable_platform_specific_config

# C++20 by default (mirrors VECTORIZATION_CXX_STANDARD=20 in CMakeLists.txt).
# MSVC takes /std:c++20, not -std=c++20 — unlike vectorization_copts()
# (bazel/vectorization.bzl), which already select() this per target, this applies to
# every target including third-party deps, so it must be split per OS too.
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20

# Backend selection examples:
#   bazel build //:Vectorization --define=vectorization_cpu_backend=avx2
#   bazel build //:Vectorization --define=vectorization_gpu_backend=metal
#   bazel build //:Vectorization --define=vectorization_cpu_backend=avx2 --define=vectorization_gpu_backend=metal
#
# GPU backend (VECTORIZATION_GPU_BACKEND). CUDA requires rules_cuda (MODULE.bazel)
# and a CUDA toolkit; HIP requires a ROCm toolchain on the system path.
#   bazel build //:Vectorization --define=vectorization_gpu_backend=cuda --define=memory_gpu_backend=cuda
#   bazel build //:Vectorization --define=vectorization_gpu_backend=hip --define=memory_gpu_backend=hip
#
# Override CUDA SM targets (default: inherits from CMAKE_CUDA_ARCHITECTURES or 75;80;86;89;90):
#   bazel build //:Vectorization --define=vectorization_gpu_backend=cuda --define=memory_gpu_backend=cuda \
#       --@rules_cuda//cuda:archs=sm_80,sm_86,sm_90
#
# CPU SIMD + GPU combined (AVX2 host, CUDA GPU):
#   bazel build //:Vectorization \
#       --define=vectorization_cpu_backend=avx2 \
#       --define=vectorization_gpu_backend=cuda --define=memory_gpu_backend=cuda
#
# CPU SIMD backend (VECTORIZATION_CPU_BACKEND). x86-64: sse | avx | avx2 | avx512
# AArch64: neon | sve
#   bazel build //:Vectorization --define=vectorization_cpu_backend=avx2
#   bazel build //:Vectorization --define=vectorization_cpu_backend=neon

# Profiler is off by default under Bazel: bazel/profiler.BUILD still targets
# Profiler's pre-include/ source layout and does not yet wire its kineto/ittapi
# dependencies, so @profiler//:Profiler does not build. CMake keeps Profiler
# auto-detected (linked whenever the CMake target exists). Re-enable with
# --define=vectorization_enable_profiler=true once the overlay is ported —
# mirrors Memory's own .bazelrc default.
build --define=vectorization_enable_profiler=false
build --define=memory_enable_profiler=false

# HIP device compilation uses ROCm Clang as Bazel's C/C++ toolchain.
# Set the actual SDK root and compiler paths for your installation:
#   bazel build //:Vectorization --define=vectorization_gpu_backend=hip --define=memory_gpu_backend=hip \
#       --repo_env=ROCM_PATH=/opt/rocm \
#       --repo_env=CC=/opt/rocm/llvm/bin/clang \
#       --repo_env=CXX=/opt/rocm/llvm/bin/clang++
# On a headless machine also pass --copt=--offload-arch=gfx90a (or your GPU).
